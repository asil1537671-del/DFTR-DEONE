[Unit]
Description=Daftari Arabic client ledger
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=daftari
Group=daftari
WorkingDirectory=/opt/daftari
EnvironmentFile=/opt/daftari/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=XDG_CACHE_HOME=/var/cache/daftari
ExecStart=/opt/daftari/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8097 --workers 2
Restart=on-failure
RestartSec=3
CacheDirectory=daftari
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/daftari

[Install]
WantedBy=multi-user.target
