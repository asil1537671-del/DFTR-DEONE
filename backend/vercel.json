{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "uv pip install --system --python 3.12 -r requirements.txt",
  "buildCommand": "python -m compileall -q .",
  "outputDirectory": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "fonts/**",
      "maxDuration": 60
    }
  },
  "routes": [
    { "src": "/api(?:/.*)?", "dest": "/api/index.py" }
  ]
}
